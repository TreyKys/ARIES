# ARES engine configuration — copy to .env and fill in. NEVER commit .env.

# --- Reporting (dashboard). Leave blank to log to console only. ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Exchange (for LIVE only; paper/replay needs none). ---
# Use TESTNET keys first. The host must be able to reach the exchange API
# (Binance geo-blocks many cloud IPs — see DEPLOY.md).
BINANCE_API_KEY=
BINANCE_SECRET=

# --- Alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Hosted monitor (optional). Leave blank to keep it local-only. ---
# The bot pushes its snapshot here so the Netlify-hosted page can show it.
# ARIES_WRITE_TOKEN must match the value set in the Netlify UI.
ARIES_STATE_URL=
ARIES_WRITE_TOKEN=

# --- Interactive Brokers (futures runner) ---
IB_HOST=127.0.0.1
IB_PORT=7497          # 7497 = paper, 7496 = LIVE (refused without --allow-live)
IB_CLIENT_ID=11

# --- Mode ---
ENGINE_MODE=PAPER
