# ARES engine configuration — copy to .env and fill in. NEVER commit .env.

# --- Reporting (dashboard). Leave blank to log to console only. ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Exchange (for LIVE only; paper/replay needs none). ---
# Use TESTNET keys first. The host must be able to reach the exchange API
# (Binance geo-blocks many cloud IPs — see DEPLOY.md).
BINANCE_API_KEY=
BINANCE_SECRET=

# --- Alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Mode ---
ENGINE_MODE=PAPER
